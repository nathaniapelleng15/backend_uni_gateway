NODE_ENV=development
PORT=8000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=unismiles
DB_USER=root
DB_PASSWORD=

# GoPay Merchant automatic QRIS confirmation (disabled until a staged rollout).
# Login with `npm run gopay:login`; OTP is prompted in the terminal, never put in env.
# Keep this session file outside the repository with owner-only file permissions.
GOPAY_MERCHANT_ENABLED=false
GOPAY_MERCHANT_ID=
GOPAY_MERCHANT_SESSION_PATH=
# Set true only temporarily to import an existing session as Super Admin over HTTPS.
# The session path must be outside this repository; disable this flag and restart
# the API immediately after import. A persistent marker also prevents reuse.
GOPAY_SESSION_IMPORT_ENABLED=false
GOPAY_MERCHANT_POLL_INTERVAL_MS=10000
GOPAY_MERCHANT_POLL_TIMEOUT_MS=30000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
PUBLIC_BASE_URL=http://localhost:8000
# Origin yang diizinkan mengakses API dari browser. WAJIB memuat domain panel
# admin yang benar-benar dipakai — perhatikan EJAANNYA.
#
# Kejadian nyata: panel admin disajikan di unismilees.uniinside.net (dobel "e"),
# tetapi daftar ini hanya memuat unismiles.uniinside.net (satu "e") — domain
# yang bahkan tidak bisa di-resolve. Browser lalu memblokir permintaan sebelum
# terkirim, dan axios melaporkannya sebagai "Network error"; server tidak pernah
# melihat permintaannya sama sekali. Jangan pernah mencetak rahasia ke ringkasan.
CORS_ORIGINS=https://unismilees.uniinside.net,https://photobooth.uniinside.net,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
ALLOW_PUBLIC_REGISTRATION=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Uni-Smiles Photobooth <your-gmail-address@gmail.com>"

# Duitku dynamic QRIS (credentials only on backend)
PAYMENT_PROVIDER=duitku
DUITKU_ENV=sandbox
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# QRIS code must be activated for this merchant: NQ, SP, or SQ
DUITKU_PAYMENT_METHOD=NQ
DUITKU_CALLBACK_URL=https://photobooth.uniinside.net/api/payments/duitku/callback
DUITKU_RETURN_URL=https://photobooth.uniinside.net
# Shared checkout contact for sandbox; configure customer email for production
DUITKU_CUSTOMER_EMAIL=sandbox@uniinside.net
DUITKU_EXPIRY_MINUTES=10
